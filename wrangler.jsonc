{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "norvenxa-norvenxa",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  }
}